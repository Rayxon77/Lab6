# include <iostream>
using namespace std;


long long sumRange(int a, int b) {
    
    long long  sum =0;
    if (a>b) {
        swap(b,a);
    }
    for (int i=a ; i<=b ; i++) {
        sum +=i;
    }
    return sum;
}

int main()  {
    int a,b;
    cin>>a>>b;
    cout<<(sumRange(a,b));
    return 0;
}
